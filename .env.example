# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Used only on the server to let people log in with their phone number.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Your live site address
NEXT_PUBLIC_SITE_URL=https://dashpad.site

# Optional: relay server so calls work on mobile data (see README → Calls)
METERED_DOMAIN=
METERED_API_KEY=
