# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Used only on the server to let people log in with their phone number.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Your live site address
NEXT_PUBLIC_SITE_URL=https://dashpad.site

# Optional: Cloudflare relay so calls work on mobile data (see README → Calls)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Paystack secret key (Settings → API Keys & Webhooks). Webhook URL: https://dashpad.site/api/paystack/webhook
PAYSTACK_SECRET_KEY=

# Admin dashboard login (dashpad.site/admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Turnstile bot protection (Cloudflare → Turnstile → Add widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (password reset emails) — resend.com
RESEND_API_KEY=
EMAIL_FROM=Dashpad <no-reply@dashpad.site>
